      if (activeEdition && activeEdition !== defaultEdition) {
        document.addEventListener(
          'click',
          (e) => {
            const anchor = e.target instanceof Element ? e.target.closest('a') : null
            if (!anchor) return
            if (anchor.hasAttribute('data-edition-link')) return
            if (anchor.hasAttribute('data-no-edition')) return
