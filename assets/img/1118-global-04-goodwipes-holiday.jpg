<link rel="https://api.w.org/" href="https://www.bandt.com.au/wp-json/" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://www.bandt.com.au/xmlrpc.php?rsd" />
<!-- start Simple Custom CSS and JS -->
<script>
(function () {
  function getVimeoId(url) {
    // supports vimeo.com/123456789 and player.vimeo.com/video/123456789
    const m = String(url).match(/vimeo\.com\/(?:video\/)?(\d+)/);
    return m ? m[1] : null;
  }

  function closeModal(overlay) {
    if (!overlay) return;
    overlay.remove(); // removes iframe too (stops playback)
    document.removeEventListener("keydown", onEsc);
  }

  function onEsc(e) {
    if (e.key === "Escape") {
      const overlay = document.querySelector(".vimeo-modal-overlay");
      closeModal(overlay);
    }
  }

  document.addEventListener("click", function (e) {
    const a = e.target.closest("a.vimeo-lightbox");
    if (!a) return;

    e.preventDefault();

    const id = getVimeoId(a.getAttribute("href"));
    if (!id) return;

    const overlay = document.createElement("div");
    overlay.className = "vimeo-modal-overlay";

    const modal = document.createElement("div");
    modal.className = "vimeo-modal";

    const closeBtn = document.createElement("button");
    closeBtn.className = "vimeo-modal-close";
    closeBtn.type = "button";
    closeBtn.setAttribute("aria-label", "Close video");
    closeBtn.innerHTML = "×";

    const iframe = document.createElement("iframe");
    iframe.setAttribute("allow", "autoplay; fullscreen; picture-in-picture");
    iframe.setAttribute("allowfullscreen", "allowfullscreen");
    iframe.src = "https://player.vimeo.com/video/" + id + "?autoplay=1";

    modal.appendChild(closeBtn);
    modal.appendChild(iframe);
    overlay.appendChild(modal);
    document.body.appendChild(overlay);

    overlay.addEventListener("click", function (evt) {
      if (evt.target === overlay) closeModal(overlay);
    });
    closeBtn.addEventListener("click", function () {
      closeModal(overlay);
    });

    document.addEventListener("keydown", onEsc);
  });
})();


</script>
<!-- end Simple Custom CSS and JS -->
