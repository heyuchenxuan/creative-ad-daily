<script id="bandt-mnwb-js-after">
/* bandt-mnwb-inline */
(function(){
  if(window.__BANDT_MNWB_INIT) return;
  window.__BANDT_MNWB_INIT = true;

  var SELECTOR = "nav#site-navigation > ul#menu-new-main-menu";
  var BREAKPOINT = 1250;
  var MAXWIDTH = 2560;

  function timeout(ms){return new Promise(function(res){setTimeout(res,ms);});}
  function debounce(fn, wait){var t;return function(){clearTimeout(t);var a=arguments;var self=this;t=setTimeout(function(){fn.apply(self,a);},wait);};}

  function getUL(){return document.querySelector(SELECTOR);}

  function reveal(){
    // Mark the document as ready so the prehide CSS releases the menu.
    document.documentElement.classList.add('bandt-mnwb-ready');
    var ul = getUL();
    if(ul) ul.classList.add('bandt-mnwb-ready');
    var w = document.querySelector('.bandt-mnwb-rows');
    if(w) w.classList.add('bandt-mnwb-ready');
  }

  function getTopLevelItems(ul){
    return Array.prototype.filter.call(ul.children,function(li){return li && li.tagName==='LI';});
  }

  function countRows(items){
    var tops = items.map(function(li){return Math.round(li.getBoundingClientRect().top);});
    var uniq=[];
    tops.forEach(function(t){if(uniq.indexOf(t)===-1) uniq.push(t);});
    return uniq.length;
  }

  function anySubMenuVisible(ul){
    try{
      var subs = ul.querySelectorAll(':scope > li ul.sub-menu');
      for(var i=0;i<subs.length;i++){
        var s = subs[i];
        var st = window.getComputedStyle(s);
        if(st && st.display !== 'none' && st.visibility !== 'hidden' && parseFloat(st.opacity||'1')>0){return true;}
      }
    }catch(e){}
    return false;
  }

  function restore(host){
    var wrapper = host.querySelector('.bandt-mnwb-rows');
    if(!wrapper) return;
    var html = wrapper.getAttribute('data-original-ul-html');
    var cls = wrapper.getAttribute('data-original-ul-class') || '';
    var id  = wrapper.getAttribute('data-original-ul-id') || '';
    var attrJson = wrapper.getAttribute('data-original-ul-attr') || '{}';
    var attrs={};
    try{attrs=JSON.parse(attrJson)||{};}catch(e){}

    var ul = document.createElement('ul');
    ul.innerHTML = html || '';
    ul.className = cls;
    if(id) ul.id = id;
    for(var k in attrs){ if(k==='class' || k==='id') continue; try{ ul.setAttribute(k, attrs[k]); }catch(e){} }
    ul.classList.add('bandt-mnwb-ready');

    host.insertBefore(ul, wrapper);
    wrapper.remove();
    try{ host.style.minHeight=''; }catch(e){}
  }

  function apply(){
    // mobile: restore original
    if(window.innerWidth < BREAKPOINT || window.innerWidth > MAXWIDTH){
      var w = document.querySelector('.bandt-mnwb-rows');
      if(w && w.parentElement) restore(w.parentElement);
      reveal();
      return;
    }

    // v1.1.4: if the prehide safety timeout already revealed the NATURAL menu
    // (fonts/JS were slow), restructuring it now would be a visible layout shift.
    // Accept the natural wrap for this pageview instead of rebalancing late.
    // v1.1.10: 'revealed' only means anything after a first paint — pre-paint the
    // menu was never visible, so rebalancing is still shift-free. Same paint-aware
    // relaxation as the poll backstop; the two guards must stay in sync.
    if(window.__BANDT_MNWB_EARLY_REVEAL && !document.querySelector('.bandt-mnwb-rows') && hasPainted()){ reveal(); return; }

    // restore for clean measurement
    var w2 = document.querySelector('.bandt-mnwb-rows');
    if(w2 && w2.parentElement) restore(w2.parentElement);

    var ul = getUL();
    if(!ul) { reveal(); return; }
    // If theme has switched to mobile/off-canvas navigation (UL hidden), do nothing.
    var cs = window.getComputedStyle(ul);
    if(!cs || cs.display === 'none' || ul.getClientRects().length === 0){
      reveal();
      return;
    }

    // If a dropdown is open, don't swap DOM under cursor
    if(anySubMenuVisible(ul)) { reveal(); return; }

    var allItems = getTopLevelItems(ul);
    if(allItems.length < 6) { reveal(); return; }

    // Split out action items (search / dots / etc.) so they stay pinned to the right
    function isActionItem(li){
      if(!li) return false;
      var cls = (li.className || '').toLowerCase();
      if(/(search|icon|dots|ellipsis|more|toggle|hamburger|burger|subscribe)/.test(cls)) return true;
      var a = li.querySelector(':scope > a, :scope > button');
      var label = (a && (a.getAttribute('aria-label') || a.getAttribute('title') || '') || '').toLowerCase();
      if(/(search|menu|more|subscribe)/.test(label)) return true;
      var txt = ((a ? a.textContent : li.textContent) || '').replace(/\s+/g, ' ' ).trim().toLowerCase();
      var hasIcon = !!li.querySelector('svg,i,button');
      if((txt === '' || txt === 'search' || txt === 'subscribe') && hasIcon) return true;
      if(a && a.children && a.children.length && a.textContent.trim() === '' && a.querySelector('svg,i')) return true;
      return false;
    }

    var actionItems = [];
    var items = [];
    allItems.forEach(function(li){ (isActionItem(li) ? actionItems : items).push(li); });
    if(items.length < 3){ items = allItems; actionItems = []; }

    var rows = countRows(items.length ? items : allItems);
    if(rows !== 2) { reveal(); return; }

    var host = ul.parentElement;
    if(!host) { reveal(); return; }

    var splitIndex = Math.ceil(items.length / 2);
    if(items.length >= 6){
      splitIndex = Math.max(2, Math.min(items.length - 2, splitIndex));
    } else {
      splitIndex = Math.max(1, Math.min(items.length - 1, splitIndex));
    }

    // Save original UL attributes so restore is exact
    var attrObj = {};
    for(var i=0;i<ul.attributes.length;i++){var a=ul.attributes[i]; attrObj[a.name]=a.value;}

    var wrapper = document.createElement('div');
    wrapper.className = 'bandt-mnwb-rows';
    wrapper.setAttribute('data-original-ul-html', ul.innerHTML);
    wrapper.setAttribute('data-original-ul-class', ul.className || '');
    wrapper.setAttribute('data-original-ul-id', ul.id || '');
    wrapper.setAttribute('data-original-ul-attr', JSON.stringify(attrObj));

    var center = document.createElement('div');
    center.className = 'bandt-mnwb-center';

    var originalClass = ul.className || '';
    var row1 = document.createElement('ul');
    row1.className = 'bandt-mnwb-row ' + originalClass;
    var row2 = document.createElement('ul');
    row2.className = 'bandt-mnwb-row ' + originalClass;

    items.slice(0, splitIndex).forEach(function(li){ row1.appendChild(li); });
    items.slice(splitIndex).forEach(function(li){ row2.appendChild(li); });

    center.appendChild(row1);
    center.appendChild(row2);
    wrapper.appendChild(center);

    if(actionItems && actionItems.length){
      var actions = document.createElement('ul');
      actions.className = 'bandt-mnwb-actions ' + originalClass;
      actionItems.forEach(function(li){ actions.appendChild(li); });
      wrapper.appendChild(actions);
    }

    // v1.1.4: lock the host's current (natural-menu) height as a min-height BEFORE
    // swapping, so the balanced layout can never make the header shorter (shift guard).
    try{ var hostH = host.getBoundingClientRect().height; if(hostH > 0){ host.style.minHeight = Math.round(hostH) + 'px'; } }catch(e){}

    host.insertBefore(wrapper, ul);
    ul.remove();
    window.__BANDT_MNWB_APPLIED = true;
  }

  function stylesReady(){
    // v1.1.6: 'the UL exists in the DOM' proved to be the wrong readiness signal —
    // it says nothing about whether the theme's stylesheet has actually loaded and
    // applied yet. Measuring countRows() before it has produced wrong splits.
    // v1.1.7: v1.1.6 checked EVERY <link rel=stylesheet> on the page, including
    // ad-network/consent/admin-bar CSS that has nothing to do with the nav's layout.
    // On ad-heavy pages that's slow; worse, if ANY third-party stylesheet fails to
    // load at all (blocked by an ad blocker, dead CDN, etc.), link.sheet stays null
    // forever and this would never return true, permanently forcing the fallback.
    // Scope this to only the theme's own stylesheet(s) — the ones that actually
    // determine the nav's layout — so irrelevant/unreliable third-party CSS can
    // never block the gate.
    try{
      var links = document.querySelectorAll('link[rel="stylesheet"][href*="/wp-content/themes/"]');
      for(var i=0;i<links.length;i++){ if(!links[i].sheet){ return false; } }
      return true;
    }catch(e){ return true; }
  }

  function fontsReady(){
    // Fallback vs. webfont metrics can change the NATURAL wrap (2 rows -> 1 or 3),
    // so the pre-balance measurement needs the NAV's real font loaded, not just real CSS.
    // v1.1.8: v1.1.7's document.fonts.status==='loaded' check required EVERY font
    // registered anywhere on the page to finish (icon fonts, ad fonts, unrelated
    // heading fonts) \u2014 same over-strict pattern that broke stylesReady() in v1.1.6.
    // Scope this to the ONE font the menu links actually render with, via
    // document.fonts.check() against a sample link's real computed font.
    try{
      if(!(document.fonts && document.fonts.check)) return true;
      var ul = getUL();
      if(!ul) return true; // can't determine yet; don't block on fonts specifically
      var sample = ul.querySelector('li > a, li > button');
      if(!sample) return true;
      var cs = window.getComputedStyle(sample);
      var spec = (cs.fontStyle||'normal') + ' ' + (cs.fontWeight||'400') + ' ' + cs.fontSize + ' ' + cs.fontFamily;
      return document.fonts.check(spec, 'Ag');
    }catch(e){ return true; }
  }

  // v1.1.8: expose the gates directly so readiness can be checked on demand in
  // console, instead of only inferring it indirectly from tries/early/applied side effects.
  window.__BANDT_MNWB_stylesReady = stylesReady;
  window.__BANDT_MNWB_fontsReady = fontsReady;

  function hasPainted(){
    // v1.1.10: CLS only counts movement of content that has actually been PAINTED.
    // Theme stylesheets are render-blocking, so on the exact cold loads where
    // stylesReady() is slow, the browser has painted NOTHING yet — rebalancing
    // 'late' in that window is invisible and cannot shift anything. Only treat
    // the early-reveal flag as a hard stop once a first paint has really happened.
    // Unsupported browsers (no Paint Timing API) fall back to true = assume
    // painted = exact v1.1.9 behaviour, no regression.
    try{
      if(!(window.performance && performance.getEntriesByType)) return true;
      return performance.getEntriesByType('paint').length > 0;
    }catch(e){ return true; }
  }
  window.__BANDT_MNWB_hasPainted = hasPainted;

  function boot(){
    // Below breakpoint the prehide CSS isn't active, but just in case
    if(window.innerWidth < BREAKPOINT || window.innerWidth > MAXWIDTH){ reveal(); return; }

    // v1.1.5: do NOT wait for DOMContentLoaded or fonts.ready-with-long-timeout. On
    // heavy pages DCL lands seconds after the safety reveal, so the old gating meant
    // the balancer effectively never ran. Instead, this script runs in <head> and
    // polls for the menu UL — while still prehidden, before first reveal.
    // v1.1.6: finding the UL is necessary but not sufficient. We also gate on
    // stylesReady()/fontsReady() so countRows() measures the REAL rendered wrap
    // (theme CSS + webfonts applied), not fallback-font/unstyled markup. Once the
    // balanced rows exist, a later font swap can't change row count (flex-wrap:nowrap),
    // but the ONE-TIME natural-wrap measurement this fix targets absolutely can.
    var tries = 0;
    (function waitForUL(){
      // Backstop: if the safety timeout already revealed the natural menu, stop —
      // but (v1.1.10) only if a first paint has actually happened. Pre-paint, the
      // 'reveal' was a no-op (render-blocking CSS = nothing on screen), so it is
      // still safe to keep waiting for stylesReady() and apply before frame one.
      // This is what fixes the cold-load 'first visit unbalanced, refresh fine'
      // behaviour without reintroducing any CLS risk.
      if(window.__BANDT_MNWB_EARLY_REVEAL && !document.querySelector('.bandt-mnwb-rows') && hasPainted()){ reveal(); return; }
      var ul = getUL();
      // Require the next sibling too, so we don't measure a UL the parser is still
      // streaming children into (li count would be incomplete mid-parse).
      var parsedPast = ul && (ul.nextElementSibling || document.readyState !== 'loading');
    // v1.1.9: fontsReady() was gating apply() here too, but it proved to be the
    // actual persistent blocker across real testing \u2014 document.fonts.check() does an
    // EXACT match against the nav's computed font, and that can stay false for reasons
    // unrelated to page readiness (slow font host, font-display timing, etc.), blocking
    // indefinitely. The original team's own notes already flagged fallback-vs-webfont
    // wrap-count changes as a low-probability edge case (documented, not fixed) \u2014 given
    // this gate is now a confirmed reliable failure and that risk was assessed as
    // unlikely, no longer requiring fontsReady() here. stylesReady() (confirmed working)
    // plus the UL-parsed check remain the gate. fontsReady() stays available via
    // window.__BANDT_MNWB_fontsReady() for diagnostics, just no longer blocks.
      if(ul && parsedPast && stylesReady()){
        window.__BANDT_MNWB_TRIES = tries;
        window.__BANDT_MNWB_HIT_CAP = false;
        apply();
        requestAnimationFrame(function(){ reveal(); });
        return;
      }
      if(++tries > 175){
        // ~7s hard cap. If the UL genuinely never appeared, selector is likely wrong —
        // reveal natural and stop. If it DID appear but styles/fonts never signalled
        // ready (e.g. a stylesheet failed to load), apply best-effort rather than
        // silently doing nothing for the whole pageview.
        window.__BANDT_MNWB_TRIES = tries;
        window.__BANDT_MNWB_HIT_CAP = true;
        if(ul){ apply(); }
        requestAnimationFrame(function(){ reveal(); });
        return;
      }
      setTimeout(waitForUL, 40);
    })();
  }

  boot();

  // Rebalance on resize only (user-driven; user-input shifts are excluded from CLS,
  // so it is safe to clear the early-reveal flag and rebalance here).
  window.addEventListener('resize', debounce(function(){ window.__BANDT_MNWB_EARLY_REVEAL = false; apply(); reveal(); }, 140));
})();

//# sourceURL=bandt-mnwb-js-after
</script>

