<style>
/* Reserve space for the desktop 970x250 header billboard so it doesn't push the page down when it loads */
@media (min-width:1024px){ #topunit{ min-height:250px; } }
</style>
<script>
/* Load the next infinite-scroll article ~1.5 screens early, so it is appended off-screen
   instead of pushing the visible footer down (main desktop CLS source). */
(function(){
  var tries=0;
  function patch(){
    var M=window.FOXIZ_MAIN_SCRIPT, W=window.Waypoint;
    var wp=M&&M.wPoint&&M.wPoint.ajaxSingleNextPosts;
    if(!wp||!W){ if(++tries<40){ setTimeout(patch,250); } return; }
    if(wp.__btEarly){ return; }
    wp.__btEarly=true;
    wp.options.offset=function(){ return this.context.innerHeight()-this.adapter.outerHeight()+Math.round(window.innerHeight*1.5); };
    W.refreshAll();
  }
  if(document.readyState==='complete'){ patch(); } else { window.addEventListener('load',patch); }
})();
</script>			<meta property="og:title" content="Page Not Found - B&amp;T"/>
			<meta property="og:url" content="https://www.bandt.com.au/wp-content/uploads/2026/11/Goodwipes-Holiday.jpg"/>
