<style id="bandt-mnwb-inline-css">

/* Menu Natural Wrap Balancer */
@media (min-width: 1250px) and (max-width: 2560px) {
  .bandt-mnwb-rows{display:flex!important;align-items:center!important;justify-content:space-between!important;flex:1 1 auto!important;min-width:0!important;width:100%!important;box-sizing:border-box;}
  .bandt-mnwb-center{flex:1 1 auto!important;min-width:0!important;display:flex!important;flex-direction:column!important;align-items:center!important;width:100%!important;box-sizing:border-box;}
  .bandt-mnwb-actions{display:flex!important;align-items:center!important;justify-content:flex-end!important;flex:0 0 auto!important;white-space:nowrap!important;list-style:none!important;margin:0!important;padding:0!important;gap:1px;}
  .bandt-mnwb-actions>li{margin:0!important;padding:0!important;}
  .bandt-mnwb-row{display:flex!important;flex-wrap:nowrap!important;justify-content:center!important;align-items:center!important;width:100%;gap:1px;margin:0!important;padding:0!important;list-style:none;}
  .bandt-mnwb-row>li{margin:0!important;padding:0!important;}
  .navbar-inner .navbar-left{flex:1 1 auto!important;min-width:0!important;}
  nav#site-navigation{overflow:visible!important;flex:1 1 auto!important;min-width:0!important;width:100%!important;}
  nav#site-navigation .sub-menu{z-index:99999!important;}
}

/* Logo sizing: pin all logo variants to one box height so variant swaps cannot shift the header */
@media (min-width: 1250px) and (max-width: 2560px) {
  .navbar-inner .logo-wrap img{display:block;height:110px!important;width:auto!important;max-width:100%;-webkit-transition:opacity .25s var(--timing);transition:opacity .25s var(--timing);object-fit:contain!important;}
}
@media (max-width: 1249px) {
  nav#site-navigation .logo-wrap{text-align:center!important;}
  nav#site-navigation .logo-wrap>a.logo{display:inline-block!important;}
  nav#site-navigation .logo-wrap img{height:90px!important;width:auto!important;max-height:90px!important;object-fit:contain!important;display:inline-block!important;}
}

/*# sourceURL=bandt-mnwb-inline-css */
</style>
